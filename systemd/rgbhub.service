[Unit]
Description=RGB Hub (OMEN PC lights and LCD, IQUNIX keyboard)
After=openrgb-server.service
Wants=openrgb-server.service
# When OpenRGB is restarted, stop first and start after it. While we hold a
# connection, OpenRGB cannot reopen its port and fails for minutes.
PartOf=openrgb-server.service

[Service]
# Runs the active version: `current` points into versions/ (or, after
# `install-user.sh --dev`, at the working copy).
# Rebuild the compiled settings list first, so a new version with new
# settings never starts against an old list.
ExecStartPre=/usr/bin/glib-compile-schemas %h/.local/share/rgbhub/current/frontends/gnome-shell/rgbhub@konfus-dev.github.io/schemas
ExecStart=%h/.local/share/rgbhub/current/.venv/bin/python -m rgbhub
Restart=on-failure
RestartSec=5
# On stop the hub first puts the Default look on every device; the RAM takes
# a few seconds of that.
TimeoutStopSec=20

[Install]
WantedBy=default.target

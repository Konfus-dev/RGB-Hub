[Unit]
Description=OpenRGB lighting server (no window), used by RGB Hub

[Service]
# Listens on this computer only. --noautoconnect stops it from trying to
# connect to another OpenRGB instead of being the server itself.
#
# OpenRGB gets its own settings folder in which every hardware detector is
# off except the case-light board. Its normal RAM probing makes the RAM's
# control bus on the OMEN 45L stop responding until the next reboot.
ExecStartPre=%h/.local/share/rgbhub/venv/bin/python -m rgbhub.platforms.linux.openrgb %h/.config/rgbhub/openrgb %h/.config/OpenRGB/OpenRGB.json
# A newer OpenRGB may know detectors the config does not switch off. Refuse to
# start it until install-user.sh has looked at the new version.
ExecStartPre=%h/.local/share/rgbhub/venv/bin/python -m rgbhub.platforms.linux.openrgb --check-program %h/.config/rgbhub/openrgb
ExecStart=/usr/bin/openrgb --server --server-host 127.0.0.1 --noautoconnect --config %h/.config/rgbhub/openrgb
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
